OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=hackalem
DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/hackalem

CORS_ORIGINS=http://localhost:5173
# Host port for the frontend; the browser reaches the API through it at /api.
FRONTEND_PORT=5173
# Address printed at the end of `docker compose up`; set it on a server, e.g. http://1.2.3.4:5173
PUBLIC_URL=
